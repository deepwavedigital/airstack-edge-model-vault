name: "fm_radio_asr_pipeline"
platform: "ensemble"
model_transaction_policy { decoupled: true }
input [
  {
    name: "INPUT"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "METADATA"
    data_type: TYPE_STRING
    dims: [ 1 ]
    optional: true
  },
  {
    name: "RESET"
    data_type: TYPE_BOOL
    dims: [ 1 ]
    optional: true
  },
  {
    name: "FLUSH"
    data_type: TYPE_BOOL
    dims: [ 1 ]
    optional: true
  }
]
output [
  {
    name: "OUTPUT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]
ensemble_scheduling {
  step [
    {
      model_name: "fm_stereo_demod"
      model_version: -1
      input_map [{
        key: "IQ_IN"
        value: "INPUT"
      },{
        key: "META_IN"
        value: "METADATA"
      }]
      output_map [{
        key: "AUDIO_OUT"
        value: "audio_data"
      },{
        key: "META_OUT"
        value: "metadata"
      }]
    },
    {
      model_name: "voxtral-mini-stt"
      model_version: -1
      input_map [{
        key: "AUDIO_IN"
        value: "audio_data"
      }]
      output_map [{
        key: "TEXT_OUT"
        value: "transcript"
      }]
    },
    {
      model_name: "fm_document_batcher"
      model_version: -1
      input_map [{
        key: "TEXT_IN"
        value: "transcript"
      },{
        key: "METADATA_IN"
        value: "metadata"
      },{
        key: "FLUSH"
        value: "FLUSH"
      },{
        key: "RESET"
        value: "RESET"
      }]
      output_map [{
        key: "OUTPUT"
        value: "OUTPUT"
      }]
    }
  ]
}
max_batch_size: 0

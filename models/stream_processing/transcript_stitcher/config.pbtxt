name: "transcript_stitcher"
backend: "python"
max_batch_size: 0

input [
  {
    name: "TEXT_IN"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "RESET"
    data_type: TYPE_BOOL
    dims: [ 1 ]
    optional: true
  }
]

output [
  {
    name: "TEXT_OUT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

parameters [
  {
    key: "min_overlap_words"
    value: { string_value: "2" }
  },
  {
    key: "max_overlap_words"
    value: { string_value: "40" }
  }
]

instance_group [{ kind: KIND_CPU }]
